{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kanopy",
  "version": "0.0.1",
  "identifier": "app.kanopy.desktop",
  "build": { "frontendDist": "../../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "kanopy", "width": 1180, "height": 920, "minWidth": 1040, "minHeight": 720, "backgroundColor": "#b9b9c0" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "shortDescription": "Living forests you can listen to",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
